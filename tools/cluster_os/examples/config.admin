general.node_id=admin-1
general.hostname=admin-1.local
general.role=admin
general.timezone=UTC
general.locale=en_US
network.enable_dynamic_ip=true
network.base_subnet=10.10.0.0/16
network.interface=eth0
network.discovery_port=9200
network.discovery_protocol=websocket
network.max_retries=5
network.auto_assign_ip=true
websocket.port=9000
websocket.tls_enabled=true
websocket.tls_cert=/etc/cluster_os/certs/cert.pem
websocket.tls_key=/etc/cluster_os/certs/key.pem
websocket.max_connections=50
websocket.heartbeat_interval_sec=10
websocket.reconnect_interval_sec=5
websocket.compression=true
admin.telemetry_interval_sec=2
admin.auth_tokens=secret-token-1,secret-token-2
admin.gui.notifications=true
